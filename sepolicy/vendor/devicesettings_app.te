allow devicesettings_app vendor_sysfs_graphics:dir search;
allow devicesettings_app vendor_sysfs_graphics:file rw_file_perms;
allow devicesettings_app vendor_sysfs_kgsl:dir search;
allow devicesettings_app vendor_sysfs_kgsl:{ file lnk_file } rw_file_perms;
allow devicesettings_app init:unix_stream_socket connectto;

# XiaomiParts dashboard
allow devicesettings_app { vendor_sysfs_kgsl_gpu_model vendor_sysfs_kgsl_gpuclk }:file r_file_perms;
allow devicesettings_app sysfs_devices_system_cpu:file rw_file_perms;
allow devicesettings_app vendor_sysfs_displayfeature:dir search;
allow devicesettings_app vendor_sysfs_displayfeature:file rw_file_perms;
allow devicesettings_app vendor_sysfs_power_supply:dir search;
allow devicesettings_app vendor_sysfs_power_supply:file rw_file_perms;
# HyperCharge: constant_charge_current lives under the pmic_glink battery_charger supply
allow devicesettings_app vendor_sysfs_battery_supply:dir search;
allow devicesettings_app vendor_sysfs_battery_supply:file rw_file_perms;
